#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T          &kp Y  &kp U  &kp I     &kp O   &kp P     &kp DEL
                &kp BSPC  &kp A  &kp S  &kp D  &kp F  &kp G          &kp H  &kp J  &kp K     &kp L   &kp SEMI  &kp APOS
                &kp LALT  &kp Z  &kp X  &kp C  &kp V  &kp B          &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH  &kp ESC
                                         &kp LCTRL  &kp SPACE      &kp RET  &kp RSHFT  &kp RGUI
            >;
        };

        number_layer {
            display-name = "NUMBER";
            bindings = <
                &kp GRAVE  &kp N1     &kp N2     &kp N3        &kp N4        &kp N5         &kp N6    &kp N7     &kp N8     &kp N9     &kp N0    &kp K_PP
                &trans     &kp MINUS  &kp EQUAL  &kp LBRC      &kp RBRC      &none          &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp BSLH  &kp K_VOL_UP
                &trans     &none      &none      &kp LG(LBRC)  &kp LG(RBRC)  &none          &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans    &kp K_VOL_DN
                                                                      &trans  &trans      &trans  &trans  &trans
            >;
        };

        function_layer {
            display-name = "FUNCTION";
            bindings = <
                &none       &kp F1        &kp F2        &kp F3        &kp F4        &kp F5               &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &none   &none   &none   &none   &none    &none F12
                &trans      &none         &none         &none         &none         &studio_unlock       &none   &none   &none   &none   &none    &none
                                                                                   &trans  &trans      &trans  &trans  &trans
            >;
        };

        numpad_layer {
            display-name = "NUMPAD";
            bindings = <
                &none     &none  &none  &none  &none  &none          &none  &kp KP_N7  &kp KP_N8  &kp KP_N9  &none         &none
                &kp BSPC  &none  &none  &none  &none  &none          &none  &kp KP_N4  &kp KP_N5  &kp KP_N6  &none         &none
                &trans    &none  &none  &none  &none  &none          &none  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_SLASH  &none
                                            &trans  &kp SPACE      &kp KP_ENTER  &kp KP_N0  &kp KP_DOT
            >;
        };
    };
};
